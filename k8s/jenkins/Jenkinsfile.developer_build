pipeline {
  agent any

  parameters {
    choice(
      name: 'SERVICE_NAME',
      choices: [
        'product', 'cart', 'order', 'customer',
        'inventory', 'tax', 'media', 'search',
        'storefront-bff', 'backoffice-bff',
        'storefront-ui', 'backoffice-ui'
      ],
      description: '🔧 Select the service to deploy from your dev branch'
    )
    string(
      name: 'DEV_BRANCH',
      defaultValue: 'main',
      description: '🌿 Dev branch name (e.g. dev_tax_service). Other services stay on main/latest.'
    )
  }

  environment {
    DOCKER_HUB_USER  = 'thaithienphu'
    K8S_NAMESPACE    = 'yas'
    KUBECONFIG_CREDS = 'kubeconfig-credentials'
  }

  stages {
    stage('Resolve Image Tag') {
      steps {
        script {
          if (params.DEV_BRANCH.trim() == 'main') {
            env.IMAGE_TAG = 'latest'
          } else {
            // Get the latest commit SHA (7 characters) of the dev branch on remote
            def gitSha = sh(
              script: "git ls-remote origin refs/heads/${params.DEV_BRANCH.trim()} | cut -f1",
              returnStdout: true
            ).trim()
            if (gitSha) {
              env.IMAGE_TAG = gitSha.take(7)
            } else {
              error "Could not resolve commit SHA for branch ${params.DEV_BRANCH}"
            }
          }
          echo "🏷️  Image tag resolved: ${env.IMAGE_TAG}"
        }
      }
    }

    stage('Deploy Service') {
      steps {
        withCredentials([file(credentialsId: env.KUBECONFIG_CREDS, variable: 'KUBECONFIG')]) {
          script {
            def chartPath = "k8s/charts/${params.SERVICE_NAME}"
            def isFrontend = params.SERVICE_NAME.endsWith('-ui')
            def prefix = isFrontend ? 'ui' : 'backend'
            def ingressHost = isFrontend 
              ? (params.SERVICE_NAME == 'storefront-ui' ? 'storefront.test.yas.local.com' : 'backoffice.test.yas.local.com')
              : 'api.test.yas.local.com'
            def dockerImageName = params.SERVICE_NAME
            if (params.SERVICE_NAME == 'storefront-ui') {
                dockerImageName = 'storefront'
            } else if (params.SERVICE_NAME == 'backoffice-ui') {
                dockerImageName = 'backoffice'
            }

            def extraArgs = ""
            if (params.SERVICE_NAME == 'storefront-bff') {
              extraArgs = "--set backend.extraEnvs[2].value=http://storefront-ui.${env.K8S_NAMESPACE}.svc.cluster.local:3000"
            } else if (params.SERVICE_NAME == 'backoffice-bff') {
              extraArgs = "--set backend.extraEnvs[2].value=http://backoffice-ui.${env.K8S_NAMESPACE}.svc.cluster.local:3000"
            } else if (params.SERVICE_NAME == 'storefront-ui') {
              extraArgs = "--set ui.extraEnvs[0].value=http://storefront-bff.${env.K8S_NAMESPACE}.svc.cluster.local/api"
            }

            sh """
              echo "📦 Building dependencies for ${params.SERVICE_NAME}..."
              helm dependency build ${chartPath}
              echo "🚀 Deploying ${params.SERVICE_NAME}:${env.IMAGE_TAG} to namespace ${env.K8S_NAMESPACE}"
              helm upgrade --install ${params.SERVICE_NAME} ${chartPath} \\
                --namespace ${env.K8S_NAMESPACE} \\
                --create-namespace \\
                --reset-values \\
                --set ${prefix}.image.repository=${env.DOCKER_HUB_USER}/${dockerImageName} \\
                --set ${prefix}.image.tag=${env.IMAGE_TAG} \\
                --set ${prefix}.ingress.host=${ingressHost} \\
                ${extraArgs} \\
                --wait --timeout 5m
            """
          }
        }
      }
    }

    stage('Print Developer Access Info') {
      steps {
        withCredentials([file(credentialsId: env.KUBECONFIG_CREDS, variable: 'KUBECONFIG')]) {
          script {
            def workerIp = sh(
              script: """curl -s ifconfig.me || curl -s ipinfo.io/ip || kubectl get nodes -o jsonpath='{.items[0].status.addresses[?(@.type=="InternalIP")].address}'""",
              returnStdout: true
            ).trim()

            echo """
╔══════════════════════════════════════════════════════════╗
║            ✅ DEPLOYMENT COMPLETE                        ║
╠══════════════════════════════════════════════════════════╣
║  Service:  ${params.SERVICE_NAME}
║  Tag:      ${env.IMAGE_TAG}
║  Branch:   ${params.DEV_BRANCH}
╠══════════════════════════════════════════════════════════╣
║  Add to your /etc/hosts:
║    ${workerIp}  storefront.test.yas.local.com
║    ${workerIp}  backoffice.test.yas.local.com
║    ${workerIp}  api.test.yas.local.com
╠══════════════════════════════════════════════════════════╣
║  Access URLs:
║    Storefront:  http://storefront.test.yas.local.com:30080
║    Backoffice:  http://backoffice.test.yas.local.com:30081
║    API:         http://api.test.yas.local.com:30082
╚══════════════════════════════════════════════════════════╝
            """
          }
        }
      }
    }
  }

  post {
    success {
      echo "✅ ${params.SERVICE_NAME} (${env.IMAGE_TAG}) deployed successfully to namespace ${env.K8S_NAMESPACE}"
    }
    failure {
      echo "❌ Deployment failed for ${params.SERVICE_NAME}. Check Console Output above."
    }
  }
}
